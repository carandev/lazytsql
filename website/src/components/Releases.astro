---
// Every lazytsql release, read from GitHub when the site is built (the website workflow rebuilds after each release).
// GitHub returns the notes already rendered and sanitized (body_html). When the API is unreachable, the page links to
// the releases instead of failing the build.
interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const t = lang === 'es'
  ? { latest: 'Última', view: 'Ver en GitHub', none: 'No se pudo leer el historial al compilar el sitio. Está en', locale: 'es' }
  : { latest: 'Latest', view: 'View on GitHub', none: 'The history could not be read when the site was built. It is at', locale: 'en' };

type Release = { tag_name: string; name: string | null; published_at: string; html_url: string; body_html?: string; draft: boolean; prerelease: boolean };
let releases: Release[] = [];
try {
  const headers: Record<string, string> = { Accept: 'application/vnd.github.html+json', 'User-Agent': 'lazytsql-website' };
  if (import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN}`;
  const response = await fetch('https://api.github.com/repos/carandev/lazytsql/releases?per_page=100', { headers });
  if (response.ok) releases = ((await response.json()) as Release[]).filter((release) => !release.draft);
} catch {
  // Offline build: the fallback link below.
}
const date = (iso: string) => new Date(iso).toLocaleDateString(t.locale, { year: 'numeric', month: 'long', day: 'numeric' });
---
{releases.length === 0 ? (
  <p>{t.none} <a href="https://github.com/carandev/lazytsql/releases">github.com/carandev/lazytsql/releases</a>.</p>
) : (
  <ol class="releases not-content">
    {releases.map((release, index) => (
      <li class="release">
        <header>
          <h2 id={release.tag_name}>{release.name || release.tag_name}</h2>
          {index === 0 && <span class="badge">{t.latest}</span>}
          <time datetime={release.published_at}>{date(release.published_at)}</time>
          <a href={release.html_url}>{t.view} ↗</a>
        </header>
        <div class="notes sl-markdown-content" set:html={release.body_html ?? ''} />
      </li>
    ))}
  </ol>
)}

<style>
  .releases { list-style: none; padding: 0; margin: 1rem 0; display: flex; flex-direction: column; gap: 1rem; }
  .release { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; padding: 1rem 1.2rem; }
  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; }
  h2 { margin: 0; font-size: var(--sl-text-h4); color: var(--sl-color-white); }
  .badge { padding: 0.05rem 0.5rem; border-radius: 999px; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); font-size: var(--sl-text-xs); }
  time { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  header a { margin-left: auto; font-size: var(--sl-text-sm); }
  .notes { margin-top: 0.6rem; font-size: var(--sl-text-sm); }
  .release :global(a) { color: var(--sl-color-text-accent); }
  .notes :global(h2) { font-size: var(--sl-text-base); margin: 0.6rem 0 0.3rem; }
  .notes :global(ul) { margin: 0.2rem 0; padding-left: 1.2rem; }
</style>
